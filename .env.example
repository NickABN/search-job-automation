DATABASE_URL=postgresql+asyncpg://app:app@127.0.0.1:5432/job_automation
POSTGRES_DB=job_automation
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
RANKING_PROFILE_IDENTIFIER=default-mexico-profile
RANKING_POLICY_VERSION=1
RANKING_TARGET_MONTHLY_MXN=26000
RANKING_LIMIT=20
RANKING_TARGET_ROLE_FAMILIES=["backend","frontend","full_stack","mobile"]
RANKING_TARGET_SKILLS=["Python","FastAPI","Java","Spring Boot","Flutter","React","Vue"]
RANKING_ENGLISH_LEVEL=B2
RANKING_ALLOWED_CITIES=["Morelia","Guadalajara","Queretaro"]
DIGEST_MIN_SCORE=60
DIGEST_MAX_JOBS=20
DIGEST_TIMEZONE=America/Mexico_City
TELEGRAM_BOT_TOKEN=replace-with-local-secret
TELEGRAM_CHAT_ID=replace-with-chat-id
